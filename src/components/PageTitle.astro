---
// The page title with a small kicker above it: the sidebar group and where the page sits in it.
const route = Astro.locals.starlightRoute;
const pad = (n: number) => String(n).padStart(2, '0');
let kicker: { group: string; place: string } | null = null;
for (const entry of route.sidebar) {
	if (entry.type !== 'group') continue;
	const index = entry.entries.findIndex((item) => item.type === 'link' && item.isCurrent);
	if (index >= 0) kicker = { group: entry.label, place: `${pad(index + 1)} / ${pad(entry.entries.length)}` };
}
---

{kicker && <p class="kicker"><span>({kicker.group})</span><span>{kicker.place}</span></p>}
<h1 id="_top">{route.entry.data.title}</h1>

<style>
	.kicker {
		display: flex;
		justify-content: space-between;
		margin: 1rem 0 0;
		padding-top: 0.7rem;
		border-top: 1px solid var(--sl-color-hairline);
		font: 400 0.7rem/1 var(--mono);
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	.kicker span:last-child { color: var(--sl-color-accent); }
	h1 { color: var(--sl-color-white); }
</style>
