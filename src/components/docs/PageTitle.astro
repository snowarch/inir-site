---
// Starlight's title with the family pick under it: the reader says which family they run once, and lines written for
// the other two step aside on every page (docs-parts.css). It shows only on pages with Settings paths or family lines.
// Starlight's PAGE_TITLE_ID, not exported: the "top" link of the page's section list points at it.
const PAGE_TITLE_ID = '_top';

const families = [
	{ id: '', name: 'All' },
	{ id: 'ii', name: 'Material' },
	{ id: 'waffle', name: 'Waffle' },
	{ id: 'iris', name: 'iRiS' },
];
---

<h1 id={PAGE_TITLE_ID}>{Astro.locals.starlightRoute.entry.data.title}</h1>
<div class="fam-pick">
	<span id="fam-pick-label">Your family</span>
	<div role="group" aria-labelledby="fam-pick-label">
		{families.map((family) => <button type="button" data-family={family.id} aria-pressed="false">{family.name}</button>)}
	</div>
</div>

<script>
	const root = document.documentElement;
	const buttons = [...document.querySelectorAll<HTMLButtonElement>('.fam-pick button')];
	const show = () => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.family === (root.dataset.family ?? ''))));
	buttons.forEach((button) => button.addEventListener('click', () => {
		const family = button.dataset.family ?? '';
		if (family) root.dataset.family = family;
		else delete root.dataset.family;
		try { family ? localStorage.setItem('inir-family', family) : localStorage.removeItem('inir-family'); } catch {}
		show();
		document.dispatchEvent(new Event('inir-family'));
	}));
	show();

	// A shot's buttons switch its pictures. In view, untouched, it walks through them by itself; the amber line's
	// animation is the clock. A reader who picked a family sees that family's picture first.
	const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
	document.querySelectorAll<HTMLElement>('figure.pv-shot').forEach((figure) => {
		const pictures = [...figure.querySelectorAll<HTMLImageElement>('.pv-frame img')];
		const buttons = [...figure.querySelectorAll<HTMLButtonElement>('.pv-seg button')];
		const run = figure.querySelector<HTMLElement>('.pv-run');
		if (pictures.length < 2 || !run) return;
		let at = 0, seen = false, held = false, clicked = false, mine = false;
		const select = (i: number) => {
			at = i;
			pictures.forEach((p, j) => { p.classList.toggle('on', j === i); p.toggleAttribute('aria-hidden', j !== i); });
			buttons.forEach((b, j) => b.setAttribute('aria-pressed', String(j === i)));
		};
		const playing = () => figure.classList.toggle('pv-playing', seen && !held && !clicked && !mine && !still);
		// Only a shot whose options are the families follows the pick; "All" lets it walk again.
		const own = () => {
			const i = new Set(buttons.map((b) => b.dataset.fam)).size > 1 ? buttons.findIndex((b) => b.dataset.fam === root.dataset.family) : -1;
			mine = i >= 0;
			if (mine) select(i);
			playing();
		};
		buttons.forEach((b, i) => b.addEventListener('click', () => { clicked = true; select(i); playing(); }));
		run.addEventListener('animationiteration', () => select((at + 1) % pictures.length));
		new IntersectionObserver(([entry]) => { seen = entry.isIntersecting; playing(); }, { threshold: 0.6 }).observe(figure);
		figure.addEventListener('pointerenter', () => { held = true; playing(); });
		figure.addEventListener('pointerleave', () => { held = false; playing(); });
		figure.addEventListener('focusin', () => { held = true; playing(); });
		figure.addEventListener('focusout', () => { held = false; playing(); });
		document.addEventListener('inir-family', own);
		own();
	});

	// A click (or Enter) on a shot shows it at full size; any click or Escape closes it, focus goes back.
	let zoom: HTMLDialogElement | null = null;
	let from: HTMLElement | null = null;
	document.querySelectorAll<HTMLElement>('figure.pv-shot .pv-frame').forEach((frame) => {
		const open = () => {
			const shown = frame.querySelector<HTMLImageElement>('img.on') ?? frame.querySelector('img');
			if (!shown) return;
			if (!zoom) {
				zoom = document.body.appendChild(Object.assign(document.createElement('dialog'), { className: 'pv-zoom' }));
				zoom.addEventListener('click', () => zoom?.close());
				zoom.addEventListener('close', () => from?.focus());
			}
			from = frame;
			zoom.replaceChildren(Object.assign(document.createElement('img'), { src: shown.src, alt: shown.alt }));
			zoom.showModal();
		};
		frame.addEventListener('click', open);
		frame.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); } });
	});

	// The parts map says where the part you point at lives and where it comes from.
	document.querySelectorAll<HTMLElement>('.pv-parts').forEach((figure) => {
		const info = figure.querySelector<HTMLElement>('[data-pt-info]');
		if (!info) return;
		const rest = info.textContent ?? '';
		figure.querySelectorAll<HTMLElement>('.pt > div').forEach((part) => {
			const show = () => {
				info.replaceChildren(`${part.querySelector('b')?.textContent}: `, Object.assign(document.createElement('code'), { textContent: part.dataset.at ?? '' }), ` · from ${part.dataset.by}`);
			};
			part.addEventListener('pointerenter', show);
			part.addEventListener('focus', show);
			part.addEventListener('pointerleave', () => { info.textContent = rest; });
			part.addEventListener('blur', () => { info.textContent = rest; });
		});
	});
</script>

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}
</style>
