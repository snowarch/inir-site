---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/rubik/400.css';
import '@fontsource/rubik/500.css';
import '@fontsource/rubik/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/looks.css';
import '../styles/home.css';
import release from '../release.generated.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (path = '') => `${base}docs/${path}`;
const asset = (path) => `${base}${path}`;
// Screenshots ship at 1920 wide with a 960 wide copy beside them (name-960.webp).
const shot = (name) => ({
	src: asset(`shots/${name}.webp`),
	srcset: `${asset(`shots/${name}-960.webp`)} 960w, ${asset(`shots/${name}.webp`)} 1920w`,
});
const repo = 'https://github.com/snowarch/iNiR';
const discord = 'https://discord.gg/pAPTfAhZUJ';
const changelog = `${repo}/blob/main/CHANGELOG.md`;
const install = ['git clone https://github.com/snowarch/inir.git', 'cd inir', './setup install'];

const looks = [
	{ id: 'inir', label: 'iNiR', swatch: ['#09060c', '#f0b65e'] },
	{ id: 'material', label: 'Material ii', swatch: ['#1d2027', '#aac7ff'] },
	{ id: 'waffle', label: 'Waffle', swatch: ['#2b2b2b', '#60cdff'] },
	{ id: 'iris', label: 'iRiS', swatch: ['#000000', '#ff9f0a'] },
];

// The parts of the 2.32 desktop in the hero, as boxes on the screenshot (percent of its width and height).
const anatomy = [
	{ id: 'island', name: 'Island', box: [40.4, 0, 16.4, 6],
		line: 'The time and the weather at rest. It grows into the page, card or panel you open, then folds back.' },
	{ id: 'pieces', name: 'Pieces', box: [63.6, 6.4, 9.4, 15.6],
		line: 'Music, the tray and your apps as bubbles, parked on the Island, on the edge or loose on the desktop.' },
	{ id: 'widgets', name: 'Widgets', box: [5.6, 7.4, 30.4, 32.6],
		line: 'They read the wallpaper under them, turn to dark ink over a bright spot and stack in one place.' },
	{ id: 'dock', name: 'Dock', box: [38, 92.6, 24, 7.4],
		line: 'On any edge. It sits opposite the Island unless you send it somewhere else.' },
];
const anatomyRest = 'iRiS in 2.32, as it ships. Pick a part to see what it does.';

const families = [
	{ id: 'material', name: 'Material ii', shot: 'material-1', doc: 'panel-families/',
		line: 'The default. A floating bar, sidebars and a dock.',
		parts: ['A bar in six styles, floating or vertical', 'A left sidebar with AI chat, YT Music, Wallhaven and an anime tracker',
			'A right sidebar with the calendar, notifications, toggles and a mixer', 'Nine global styles, from Material to Editorial'] },
	{ id: 'waffle', name: 'Waffle', shot: 'waffle-1', doc: 'panel-families/',
		line: 'A taskbar, a start menu and an action centre, after Windows 11.',
		parts: ['A taskbar with the start button in the middle', 'A start menu with pinned and recommended apps',
			'An action centre and a notification centre', 'A widgets panel on the left'] },
	{ id: 'iris', name: 'iRiS', shot: 'iris-desktop', doc: 'iris/',
		line: 'An Island that becomes the page, card or panel you open.',
		parts: ['The Island on any edge, or a menu bar it hangs from', 'Pieces you park on the Island, the edge or the desktop',
			'A Dock on any edge', 'Twenty themes, glass, and Dark, Ink and Light'] },
];

const edges = ['top', 'right', 'bottom', 'left'];

const iris = [
	{ name: 'Customize on the shell', command: 'inir iris edit',
		text: 'Click the Island, the Dock or a bubble and its options grow out of it. Studio keeps every area in one panel if you prefer.' },
	{ name: 'Twenty themes', command: 'inir iris theme apply:liquid-glass',
		text: 'Whole redesigns, not palettes, and your own as JSON files you can share.',
		names: ['iRiS', 'Liquid Glass', 'Frost', 'Obsidian', 'Aurora', 'Terminal', 'Neo Tokyo', 'Twilight', 'Daybreak', 'Horizon',
			'Monolith', 'Sakura', 'Meadow', 'Unit-01', 'Magical Girl', 'Spirit Forest', 'Signal', 'iNiR', 'Lume', 'Adaptive'] },
	{ name: 'Menu bar', command: 'inir iris layout menubar',
		text: 'A thin strip with your workspaces, the window and your pieces. The Island hangs from it as a notch.' },
	{ name: 'A Control Center you arrange', command: 'inir iris control edit',
		text: 'Every quick toggle, the player and each slider as cells you drag, resize and add from a library.' },
	{ name: 'A lock screen you rehearse', command: 'inir iris lock edit',
		text: 'The real lock opens editable with nothing to unlock. Move the clock, the player and the sign-in field, and put a video behind them.' },
	{ name: 'Orbit', command: 'inir orbit toggle',
		text: 'Your session from the Island: the workspace you are on as a strip of its windows, its neighbours above and below. Off until you turn it on.' },
];

// Each screenshot's seed, found the way the shell finds it (the most colourful hue that covers the most of the
// wallpaper), and its tonal strip from light to dark. The third tone is the accent.
const wallpapers = [
	{ id: 'blue', shot: 'material-1', label: 'Blue silk', surface: '#0e141f', quiet: '#aeb8cb',
		tones: ['#e1efff', '#bdd8ff', '#93bcff', '#668fe8', '#3f60a7', '#243b6c', '#131e37'] },
	{ id: 'red', shot: 'material-2', label: 'Red', surface: '#1e0f10', quiet: '#cab0b1',
		tones: ['#ffe4e5', '#ffc3c6', '#ff9aa1', '#da6a75', '#9c424b', '#64262d', '#331417'] },
	{ id: 'leaves', shot: 'material-3', label: 'Leaves', surface: '#191306', quiet: '#c0b6a2',
		tones: ['#fbedd1', '#f0d49b', '#e4b750', '#b98a00', '#825c00', '#523800', '#2a1d00'] },
	{ id: 'dusk', shot: 'iris-principal', label: 'Dusk', surface: '#16111d', quiet: '#bbb3c7',
		tones: ['#f4e8ff', '#e3cbff', '#d0a8ff', '#a57ad7', '#724f9a', '#482f63', '#241932'] },
];
const paperStyle = (paper) => [`--wp-surface:${paper.surface}`, `--wp-quiet:${paper.quiet}`,
	...paper.tones.map((tone, index) => `--wp-${index + 1}:${tone}`)].join(';');
const targets = [
	{ group: 'Terminals', items: 'foot, kitty, Alacritty, Ghostty and WezTerm' },
	{ group: 'In them', items: 'Starship, fuzzel, btop, lazygit and yazi' },
	{ group: 'Apps', items: 'GTK 3 and 4, Qt, Firefox, Discord and Vesktop, Zed, VS Code, Spicetify and Steam' },
	{ group: 'Before you log in', items: 'SDDM' },
];

const distros = [
	{ id: 'arch', label: 'Arch', support: 'The primary target' },
	{ id: 'fedora', label: 'Fedora', support: 'Automated, 43 or newer' },
	{ id: 'debian', label: 'Debian', support: 'Automated, testing or newer' },
	{ id: 'ubuntu', label: 'Ubuntu', support: 'Automated, 25.10 or newer' },
	{ id: 'nixos', label: 'NixOS', support: 'An experimental flake' },
];
const daily = [
	{ command: 'inir settings', text: 'Everything is in Settings, or in config.json if you prefer a file.' },
	{ command: 'inir doctor', text: 'Finds what is wrong and fixes most of it.' },
	{ command: 'inir update', text: 'Pulls, migrates your config and restarts, keeping your changes.' },
	{ command: './setup rollback', text: 'Undoes the last update.' },
];

const featured = release.added.slice(0, 8);
const more = release.added.slice(8);
const minor = release.version?.split('.').slice(0, 2).join('.');
const released = release.date
	? new Date(`${release.date}T12:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })
	: null;
const description = 'Your entire desktop for Niri: the bar, the dock, notifications, settings and wallpapers. A complete shell built on Quickshell.';
---

<!doctype html>
<html lang="en" data-look="inir">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>iNiR, a desktop shell for Niri</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#09060c" />
		<link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
		<meta property="og:title" content="iNiR" />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={asset('shots/iris-principal.webp')} />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="preload" as="image" href={shot('iris-principal').src} imagesrcset={shot('iris-principal').srcset} imagesizes="(max-width: 1360px) 100vw, 1300px" />
		<script is:inline>
			document.documentElement.classList.add('js');
			try {
				const asked = new URLSearchParams(location.search).get('look');
				const look = ['inir', 'material', 'waffle', 'iris'].includes(asked) ? asked : localStorage.getItem('inir-look');
				if (look) document.documentElement.dataset.look = look;
			} catch {}
		</script>
	</head>
	<body>
		<a class="skip" href="#top">Skip to the page</a>

		<!-- The browser window wears iRiS's chassis, and the Island hangs from its top edge. -->
		<div class="frame" aria-hidden="true"></div>

		<header class="island" data-open="false">
			<button type="button" class="island-rest" aria-expanded="false" aria-controls="island-panel" aria-label="Menu">
				<img src={asset('favicon.svg')} alt="" width="20" height="20" />
				<span class="island-where" aria-hidden="true">iNiR</span>
				<span class="island-time" aria-hidden="true"></span>
			</button>
			<div class="island-panel" id="island-panel" inert>
				<nav aria-label="Site">
					<a href={docs()}>Docs</a>
					<a href={docs('install/')}>Install</a>
					<a href={docs('keybinds/')}>Keybinds</a>
					<a href={changelog}>Changelog</a>
					<a href={repo}>GitHub</a>
					<a href={discord}>Discord</a>
				</nav>
				<p class="looks-label" id="looks-label">Dress this site as</p>
				<div class="looks" role="radiogroup" aria-labelledby="looks-label">
					{looks.map((look) => (
						<button type="button" role="radio" aria-checked="false" data-set-look={look.id}>
							<span class="swatch" style={`--a:${look.swatch[0]};--b:${look.swatch[1]}`}></span>
							{look.label}
						</button>
					))}
				</div>
			</div>
		</header>

		<main id="top">
			<section class="hero" data-island="iNiR">
				<div class="hero-copy">
					<h1>Your entire desktop, for&nbsp;Niri.</h1>
					<div class="hero-side">
						<p>The bar, the dock, notifications, settings and wallpapers, all of it. One shell built on Quickshell, in three
							families you can switch between at any time.</p>
						<div class="actions">
							<a class="button primary" href="#install">Install iNiR</a>
							<a class="button" href={docs()}>Read the docs</a>
						</div>
					</div>
				</div>

				<figure class="anatomy" data-part="">
					<div class="anatomy-screen">
						<img {...shot('iris-principal')} sizes="(max-width: 1360px) 100vw, 1300px" width="1920" height="1080"
							alt="The iRiS family in iNiR 2.32: a music widget, screen time and temperatures on the left, a bubble with album art, the Dock at the bottom and the Island at the top" fetchpriority="high" />
						<span class="lens" aria-hidden="true"></span>
					</div>
					<figcaption class="anatomy-dock">
						<div class="dock chassis" role="group" aria-label="Parts of the desktop">
							{anatomy.map((part) => (
								<button type="button" data-part={part.id} data-box={part.box.join(' ')} data-line={part.line} aria-pressed="false">{part.name}</button>
							))}
						</div>
						<p class="anatomy-say" aria-live="polite" data-rest={anatomyRest}>{anatomyRest}</p>
					</figcaption>
				</figure>
			</section>

			{release.version && (
				<section class="release" id="new" data-island={`New in ${minor}`} aria-labelledby="new-title">
					<article class="update chassis">
						<header class="update-head">
							<img src={asset('favicon.svg')} alt="" width="52" height="52" />
							<div>
								<h2 id="new-title">iNiR {release.version}</h2>
								<p>{[release.title, released && `released ${released}`].filter(Boolean).join(', ')}</p>
							</div>
							<div class="update-act">
								<span>Already on iNiR?</span>
								<button type="button" class="cmd" data-copy="inir update"><code>inir update</code></button>
							</div>
						</header>
						{release.summary && <p class="update-summary">{release.summary}</p>}
						<ul class="update-list">
							{featured.map((item) => (
								<li>
									<h3>{item.name}</h3>
									<p>{item.text}</p>
									{item.command && <button type="button" class="cmd" data-copy={item.command}><code>{item.command}</code></button>}
								</li>
							))}
						</ul>
						<footer class="update-foot">
							{more.length > 0 && (
								<details>
									<summary>{more.length} more in {release.version}</summary>
									<ul class="update-more">
										{more.map((item) => <li><strong>{item.name}.</strong> {item.text}</li>)}
									</ul>
								</details>
							)}
							<a class="text-link" href={changelog}>The whole changelog</a>
						</footer>
					</article>
				</section>
			)}

			<section class="families" id="families" data-island="Families" aria-labelledby="families-title">
				<div class="section-head">
					<h2 id="families-title">Three families, one shell.</h2>
					<p>Each family is a whole desktop with its own bar, panels and settings. Your apps, wallpaper, colours and
						keybinds come along when you switch.</p>
				</div>

				<div class="families-body">
					<div class="family-side">
						<div class="family-options" role="radiogroup" aria-label="Family">
							{families.map((family, index) => (
								<button type="button" role="radio" aria-checked={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}
									data-family={family.id} data-src={shot(family.shot).src} data-srcset={shot(family.shot).srcset} data-alt={`The ${family.name} family`}>
									<span class={`glyph glyph-${family.id}`} aria-hidden="true"><i></i><i></i><i></i></span>
									<span class="family-text">
										<strong>{family.name}</strong>
										<span>{family.line}</span>
									</span>
								</button>
							))}
						</div>
						{families.map((family, index) => (
							<div class="family-more" data-family={family.id} hidden={index !== 0}>
								<ul>{family.parts.map((part) => <li>{part}</li>)}</ul>
								<a class="text-link" href={docs(family.doc)}>More about {family.name}</a>
							</div>
						))}
						<button type="button" class="family-switch" aria-label="Next family, which is Super Shift W on your desktop">
							<span>Next family</span>
							<span class="keys" aria-hidden="true"><kbd>Super</kbd><kbd>Shift</kbd><kbd>W</kbd></span>
						</button>
					</div>

					<figure class="stage" data-family={families[0].id} data-phase="">
						<img {...shot(families[0].shot)} sizes="(max-width: 1100px) 100vw, 860px" width="1920" height="1080" alt={`The ${families[0].name} family`} loading="lazy" />
						<span class="stage-mark" aria-hidden="true">{families[0].name}</span>
					</figure>
				</div>
			</section>

			<section class="iris" id="iris" data-island="iRiS" aria-labelledby="iris-title">
				<div class="section-head">
					<h2 id="iris-title">iRiS, the Island family.</h2>
					<p>The newest family and the one moving fastest. One shape on a screen edge answers what is happening and
						becomes whatever you open. Every part of it has a command, so you can bind it or script it.</p>
				</div>

				<div class="edges">
					<div class="edges-copy">
						<h3>Any edge</h3>
						<p>Put the Island on the top, bottom, left or right. On a side it stands up with a stacked clock. The Dock sits
							opposite, and sending one to the other's edge makes them trade places.</p>
						<p class="hint">Click an edge of the screen to move it there.</p>
						<button type="button" class="cmd" data-copy="inir iris edge top"><code>inir iris edge <span class="edge-word">top</span></code></button>
					</div>
					<div class="edge-screen" data-edge="top">
						<div class="edge-scene" aria-hidden="true">
							<span class="column c1"></span><span class="column c2"></span><span class="column c3"></span>
							<span class="demo-island"><span class="demo-time"><span>14</span><span>58</span></span></span>
							<span class="demo-dock"><i></i><i></i><i></i><i></i><i></i></span>
						</div>
						<div class="edge-hits" role="radiogroup" aria-label="Edge for the Island">
							{edges.map((edge) => (
								<button type="button" role="radio" class={`edge-hit ${edge}`} aria-checked={edge === 'top' ? 'true' : 'false'}
									tabindex={edge === 'top' ? 0 : -1} data-edge={edge} aria-label={`${edge.charAt(0).toUpperCase() + edge.slice(1)} edge`}></button>
							))}
						</div>
					</div>
				</div>

				<div class="schemes">
					<div class="wipe" style="--pos: 50%">
						<img {...shot('iris-principal')} sizes="(max-width: 1100px) 100vw, 760px" width="1920" height="1080" alt="iRiS in the Dark scheme" loading="lazy" />
						<img class="wipe-light" {...shot('iris-light')} sizes="(max-width: 1100px) 100vw, 760px" width="1920" height="1080" alt="iRiS in the Light scheme" loading="lazy" />
						<span class="wipe-handle" aria-hidden="true"><span class="wipe-pill"><b>Dark</b><b>Light</b></span></span>
						<input type="range" min="0" max="100" value="50" aria-label="Show more of the Dark or the Light scheme" />
					</div>
					<div class="schemes-copy">
						<h3>Dark, Ink and Light</h3>
						<p>Ink is washi and sumi, softer than white. The scheme is the system's mode, so GTK, Qt, terminals and VS Code
							switch with the shell, and widgets turn to dark ink where the wallpaper under them is bright.</p>
						<p class="hint">Drag across the desktop to compare.</p>
						<button type="button" class="cmd" data-copy="inir colorMode set light"><code>inir colorMode set light</code></button>
					</div>
				</div>

				<ul class="iris-list">
					{iris.map((item) => (
						<li>
							<h3>{item.name}</h3>
							<p>{item.text}</p>
							{item.names && <p class="theme-names">{item.names.join(', ')}.</p>}
							<button type="button" class="cmd" data-copy={item.command}><code>{item.command}</code></button>
						</li>
					))}
				</ul>

				<div class="iris-shots">
					<figure>
						<img {...shot('iris-card')} sizes="(max-width: 760px) 100vw, 640px" width="1920" height="1080" alt="iRiS with the weather card open under the Island" loading="lazy" />
						<figcaption>The Island opened into the weather card, over a menu bar.</figcaption>
					</figure>
					<figure>
						<img {...shot('iris-dock')} sizes="(max-width: 760px) 100vw, 640px" width="1920" height="1080" alt="iRiS with a Dock preview of two kitty windows" loading="lazy" />
						<figcaption>Dock previews show each window where Niri keeps it.</figcaption>
					</figure>
				</div>
				<a class="text-link" href={docs('iris/')}>Everything iRiS can do</a>
			</section>

			<section class="colour" id="colour" data-island="Colour" aria-labelledby="colour-title" style={paperStyle(wallpapers[0])}>
				<div class="section-head">
					<h2 id="colour-title">Colours from your wallpaper.</h2>
					<p>Change the wallpaper and the shell takes its colours, then hands them to everything else. Pick one here and
						this part of the page does the same.</p>
				</div>

				<div class="colour-body">
					<div class="colour-view">
						{wallpapers.map((paper, index) => (
							<img {...shot(paper.shot)} sizes="(max-width: 1100px) 100vw, 720px" width="1920" height="1080" alt="" loading="lazy"
								data-paper={paper.id} class={index === 0 ? 'shown' : ''} />
						))}
					</div>
					<div class="colour-side">
						<div class="papers" role="radiogroup" aria-label="Wallpaper">
							{wallpapers.map((paper, index) => (
								<button type="button" role="radio" aria-checked={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}
									data-paper={paper.id} data-tones={paperStyle(paper)} data-seed={paper.tones[2]} aria-label={paper.label}>
									<img src={asset(`shots/${paper.shot}-960.webp`)} alt="" width="960" height="540" loading="lazy" />
								</button>
							))}
						</div>
						<figure class="tones">
							<div class="tone-strip" aria-hidden="true">
								{wallpapers[0].tones.map((_, index) => <span style={`background: var(--wp-${index + 1})`}></span>)}
							</div>
							<figcaption>Seven tones from the seed <span class="seed">{wallpapers[0].tones[2]}</span>. The third is the accent.</figcaption>
						</figure>
						<dl class="targets">
							{targets.map((target) => (
								<div><dt>{target.group}</dt><dd>{target.items}</dd></div>
							))}
						</dl>
					</div>
				</div>

				<div class="colour-more">
					<p><strong>Rather pick a palette?</strong> Catppuccin, Nord, Rosé Pine, Tokyo Night, Gruvbox and Regalia ship as
						presets, and your own sit beside them.</p>
					<p><strong>Material ii has nine global styles.</strong> Material, Cards, Aurora, iNiR, Angel, Regalia, ZZZ, Cookie
						Shapes and Editorial change how every panel is drawn.</p>
					<a class="text-link" href={docs('theming-presets/')}>Theming in detail</a>
				</div>
			</section>

			<section class="install" id="install" data-island="Install" aria-labelledby="install-title" style={`--ascii: url(${asset('shots/background.webp')})`}>
				<div class="install-copy">
					<h2 id="install-title">Install it.</h2>
					<p>iNiR needs Qt 6.9 or newer. The installer checks yours first and says so if it is older, instead of failing
						halfway.</p>
					<ul class="distros">
						{distros.map((distro) => (
							<li>
								<img src={asset(`distros/${distro.id}-symbolic.svg`)} alt="" width="20" height="20" />
								<strong>{distro.label}</strong>
								<span>{distro.support}</span>
							</li>
						))}
					</ul>
					<p class="note">Not for low-spec machines. You can strip it down a lot though: turn off effects, drop panels,
						flatten the design.</p>
				</div>

				<div class="install-steps">
					<div class="terminal chassis">
						<ol>
							{install.map((line) => <li><code>{line}</code></li>)}
						</ol>
						<button type="button" class="copy" data-copy={install.join('\n')}>Copy all three</button>
					</div>
					<p class="after">The installer asks before each step. When it finishes, restart and pick Niri at the login
						screen. <a class="text-link" href={docs('install/')}>Installing in detail</a></p>

					<h3 class="daily-title">After that</h3>
					<dl class="daily">
						{daily.map((item) => (
							<div><dt><button type="button" class="cmd" data-copy={item.command}><code>{item.command}</code></button></dt><dd>{item.text}</dd></div>
						))}
					</dl>
				</div>
			</section>
		</main>

		<footer>
			<div class="sign">
				<img src={asset('favicon.svg')} alt="" width="40" height="40" />
				<p><strong>iNiR{release.version && ` ${release.version}`}</strong> Your entire desktop, for Niri. Free software under the
					GPL-3.0, made by snowarch and the people who show up in the Discord.</p>
			</div>
			<nav class="footer-links" aria-label="More">
				<div>
					<h2>Docs</h2>
					<a href={docs('install/')}>Install</a>
					<a href={docs('keybinds/')}>Keybinds</a>
					<a href={docs('ipc/')}>IPC reference</a>
					<a href={docs('limitations/')}>Known limitations</a>
				</div>
				<div>
					<h2>Project</h2>
					<a href={repo}>GitHub</a>
					<a href={changelog}>Changelog</a>
					<a href={discord}>Discord</a>
					<a href="https://github.com/snowarch/iNiR-Walls">iNiR-Walls</a>
				</div>
				<div>
					<h2>Built on</h2>
					<a href="https://github.com/YaLTeR/niri">Niri</a>
					<a href="https://quickshell.outfoxxed.me/">Quickshell</a>
					<a href="https://github.com/end-4/dots-hyprland">end-4's illogical-impulse</a>
				</div>
			</nav>
		</footer>

		<p class="sr-only" aria-live="polite" id="announce"></p>

		<script>
			const root = document.documentElement;
			const reduced = matchMedia('(prefers-reduced-motion: reduce)');
			const announce = (text: string) => { const live = document.getElementById('announce'); if (live) live.textContent = text; };

			// Arrow keys move between the options of a radiogroup, as they do in the shell's own pickers.
			function radios(group: Element, pick: (button: HTMLElement) => void) {
				const options = [...group.querySelectorAll<HTMLElement>('[role="radio"]')];
				options.forEach((option, index) => {
					option.addEventListener('click', () => pick(option));
					option.addEventListener('keydown', (event) => {
						const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[event.key];
						if (!step) return;
						event.preventDefault();
						const next = options[(index + step + options.length) % options.length];
						next.focus();
						pick(next);
					});
				});
				return options;
			}
			function check(options: HTMLElement[], chosen: HTMLElement) {
				options.forEach((option) => {
					const on = option === chosen;
					option.setAttribute('aria-checked', String(on));
					if (option.hasAttribute('tabindex')) option.tabIndex = on ? 0 : -1;
				});
			}

			// The Island: it rests as the mark, where you are on the page and the time, and grows into the menu.
			const island = document.querySelector<HTMLElement>('.island')!;
			const rest = island.querySelector<HTMLButtonElement>('.island-rest')!;
			const panel = island.querySelector<HTMLElement>('.island-panel')!;
			const where = island.querySelector<HTMLElement>('.island-where')!;
			const time = island.querySelector<HTMLElement>('.island-time')!;
			const fit = () => {
				const open = island.dataset.open === 'true';
				const restBox = rest.getBoundingClientRect();
				const panelBox = panel.getBoundingClientRect();
				island.style.setProperty('--w', `${Math.ceil(open ? Math.max(restBox.width, panelBox.width) : restBox.width)}px`);
				island.style.setProperty('--h', `${Math.ceil(open ? restBox.height + panelBox.height : restBox.height)}px`);
			};
			const setOpen = (open: boolean) => {
				island.dataset.open = String(open);
				rest.setAttribute('aria-expanded', String(open));
				panel.inert = !open;
				fit();
				if (open) panel.querySelector<HTMLElement>('a')?.focus({ preventScroll: true });
			};
			rest.addEventListener('click', () => setOpen(island.dataset.open !== 'true'));
			document.addEventListener('keydown', (event) => {
				if (event.key === 'Escape' && island.dataset.open === 'true') { setOpen(false); rest.focus(); }
			});
			document.addEventListener('pointerdown', (event) => {
				if (island.dataset.open === 'true' && !island.contains(event.target as Node)) setOpen(false);
			});
			const clock = new Intl.DateTimeFormat(undefined, { hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
			const tick = () => { time.textContent = clock.format(new Date()); };
			tick();
			setInterval(tick, 15000);
			new ResizeObserver(fit).observe(rest);
			new ResizeObserver(fit).observe(panel);
			const settle = () => { fit(); island.classList.add('ready'); };
			Promise.race([document.fonts?.ready, new Promise((resolve) => setTimeout(resolve, 1200))]).then(settle);

			// The Island names the part of the page you are reading: the last one whose top has passed 45% of the screen.
			const regions = [...document.querySelectorAll<HTMLElement>('[data-island]')];
			let pending = false;
			const locate = () => {
				pending = false;
				const line = innerHeight * 0.45;
				const current = regions.filter((region) => region.getBoundingClientRect().top <= line).pop() ?? regions[0];
				const label = current.dataset.island ?? 'iNiR';
				if (where.textContent !== label) where.textContent = label;
			};
			addEventListener('scroll', () => { if (!pending) { pending = true; requestAnimationFrame(locate); } }, { passive: true });
			locate();

			const looks = radios(island.querySelector('.looks')!, (button) => {
				root.dataset.look = button.dataset.setLook;
				try { localStorage.setItem('inir-look', button.dataset.setLook!) } catch {}
				check(looks, button);
			});
			check(looks, looks.find((b) => b.dataset.setLook === (root.dataset.look ?? 'inir')) ?? looks[0]);

			// The hero's parts: the Dock under the screenshot picks one, a lens moves to it and the desktop around it dims.
			const anatomy = document.querySelector<HTMLElement>('.anatomy')!;
			const lens = anatomy.querySelector<HTMLElement>('.lens')!;
			const say = anatomy.querySelector<HTMLElement>('.anatomy-say')!;
			const parts = [...anatomy.querySelectorAll<HTMLButtonElement>('button[data-part]')];
			const show = (part: HTMLButtonElement | null) => {
				anatomy.dataset.part = part?.dataset.part ?? '';
				parts.forEach((b) => b.setAttribute('aria-pressed', String(b === part)));
				say.textContent = part ? part.dataset.line! : say.dataset.rest!;
				if (!part) return;
				const [x, y, w, h] = part.dataset.box!.split(' ');
				lens.style.cssText = `left:${x}%;top:${y}%;width:${w}%;height:${h}%`;
			};
			parts.forEach((part) => {
				part.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') show(part); });
				part.addEventListener('focus', () => show(part));
				part.addEventListener('click', () => show(part.getAttribute('aria-pressed') === 'true' ? null : part));
			});
			anatomy.querySelector('.dock')!.addEventListener('pointerleave', (event) => {
				if ((event as PointerEvent).pointerType === 'mouse') show(null);
			});
			anatomy.addEventListener('focusout', (event) => {
				if (!anatomy.contains((event as FocusEvent).relatedTarget as Node)) show(null);
			});

			// Families switch the way the shell does it: the desktop zooms and blurs away, the family's mark holds, and
			// the next one settles in.
			const stage = document.querySelector<HTMLElement>('.stage')!;
			const stageImage = stage.querySelector('img')!;
			const stageMark = stage.querySelector<HTMLElement>('.stage-mark')!;
			const mores = [...document.querySelectorAll<HTMLElement>('.family-more')];
			let switching = Promise.resolve();
			const familyButtons = radios(document.querySelector('.family-options')!, (button) => {
				if (button.getAttribute('aria-checked') === 'true') return;
				check(familyButtons, button);
				mores.forEach((more) => { more.hidden = more.dataset.family !== button.dataset.family; });
				switching = switching.then(() => swap(button));
			});
			const wait = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
			async function swap(button: HTMLElement) {
				const next = new Image();
				next.srcset = button.dataset.srcset!;
				next.sizes = stageImage.sizes;
				next.src = button.dataset.src!;
				const ready = next.decode().catch(() => {});
				const name = button.querySelector('strong')!.textContent!;
				const animate = !reduced.matches;
				if (animate) {
					stageMark.textContent = name;
					stage.dataset.family = button.dataset.family;
					stage.dataset.phase = 'out';
					await wait(380);
				}
				await ready;
				stageImage.srcset = next.srcset;
				stageImage.src = next.src;
				stageImage.alt = button.dataset.alt!;
				stage.dataset.family = button.dataset.family;
				if (animate) { await wait(200); stage.dataset.phase = 'in'; await wait(380); }
				stage.dataset.phase = '';
				announce(`${name} family`);
			}
			document.querySelector('.family-switch')!.addEventListener('click', () => {
				const current = familyButtons.findIndex((b) => b.getAttribute('aria-checked') === 'true');
				familyButtons[(current + 1) % familyButtons.length].click();
			});
			// A look named after a family opens on that family.
			familyButtons.find((b) => b.dataset.family === root.dataset.look)?.click();

			// The edge demo: the screen's own edges are the control.
			const screen = document.querySelector<HTMLElement>('.edge-screen')!;
			const edgeWord = document.querySelector<HTMLElement>('.edge-word')!;
			const edgeButtons = radios(screen.querySelector('.edge-hits')!, (button) => {
				const edge = button.dataset.edge!;
				check(edgeButtons, button);
				screen.dataset.edge = edge;
				edgeWord.textContent = edge;
				edgeWord.closest<HTMLElement>('[data-copy]')!.dataset.copy = `inir iris edge ${edge}`;
				announce(`Island on the ${edge} edge, Dock opposite`);
			});

			// Dark against Light.
			const wipe = document.querySelector<HTMLElement>('.wipe')!;
			wipe.querySelector('input')!.addEventListener('input', (event) => {
				wipe.style.setProperty('--pos', `${(event.target as HTMLInputElement).value}%`);
			});

			// Colours: the section takes the tones of the wallpaper you pick.
			const colour = document.querySelector<HTMLElement>('.colour')!;
			const seed = colour.querySelector<HTMLElement>('.seed')!;
			const papers = radios(colour.querySelector('.papers')!, (button) => {
				check(papers, button);
				colour.style.cssText = button.dataset.tones!;
				seed.textContent = button.dataset.seed!;
				colour.querySelectorAll<HTMLElement>('.colour-view img').forEach((img) => img.classList.toggle('shown', img.dataset.paper === button.dataset.paper));
			});

			// Commands copy on click.
			document.querySelectorAll<HTMLElement>('[data-copy]').forEach((button) => button.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(button.dataset.copy!);
					button.classList.remove('copied');
					void button.offsetWidth;
					button.classList.add('copied');
					announce('Copied');
					setTimeout(() => button.classList.remove('copied'), 1400);
				} catch {}
			}));
		</script>
	</body>
</html>
