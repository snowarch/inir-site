---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/home.css';
import release from '../release.generated.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (path = '') => `${base}docs/${path}`;
const asset = (path) => `${base}${path}`;
// Screenshots ship at 1920 wide with a 960 wide copy beside them (name-960.webp).
const shot = (name) => ({
	src: asset(`shots/${name}.webp`),
	srcset: `${asset(`shots/${name}-960.webp`)} 960w, ${asset(`shots/${name}.webp`)} 1920w`,
});
const repo = 'https://github.com/snowarch/iNiR';
const discord = 'https://discord.gg/pAPTfAhZUJ';
const changelog = `${repo}/blob/main/CHANGELOG.md`;
const install = ['git clone https://github.com/snowarch/inir.git', 'cd inir', './setup install'];

const strip = ['material-1', 'iris-card', 'iris-principal', 'waffle-1', 'iris-light'];

const families = [
	{ id: 'material', name: 'Material ii', shot: 'material-1', doc: 'panel-families/',
		line: 'The default. A floating bar, sidebars and a dock.' },
	{ id: 'waffle', name: 'Waffle', shot: 'waffle-1', doc: 'panel-families/',
		line: 'A taskbar, a start menu and an action centre, after Windows 11.' },
	{ id: 'iris', name: 'iRiS', shot: 'iris-desktop', doc: 'iris/',
		line: 'An Island that becomes the page, card or panel you open.' },
];

const things = [
	{ name: 'The Island', tags: ['iRiS', 'Dock', 'Widgets'], doc: 'iris/',
		text: 'One shape on any screen edge that becomes whatever you open. Every part has a command you can bind or script.' },
	{ name: 'Colour from your wallpaper', tags: ['Terminals', 'GTK', 'Qt', 'Discord'], doc: 'theming-presets/',
		text: 'Change the wallpaper and the shell, your terminals and your apps follow. Presets and your own themes sit beside it.' },
	{ name: 'Settings and a CLI', tags: ['Settings', 'IPC', 'inir doctor'], doc: 'ipc/',
		text: 'Everything is in Settings or in config.json. inir doctor finds what is wrong and fixes most of it.' },
];

const distros = [
	{ label: 'Arch', support: 'The primary target' },
	{ label: 'Fedora', support: '43 or newer' },
	{ label: 'Debian', support: 'testing or newer' },
	{ label: 'Ubuntu', support: '25.10 or newer' },
	{ label: 'NixOS', support: 'An experimental flake' },
];

const latest = release.added.slice(0, 4);
const minor = release.version?.split('.').slice(0, 2).join('.');
const description = 'Your entire desktop for Niri: the bar, the dock, notifications, settings and wallpapers. A complete shell built on Quickshell.';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>iNiR, a desktop shell for Niri</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#121212" />
		<link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
		<meta property="og:title" content="iNiR" />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={asset('shots/iris-principal.webp')} />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<a class="skip" href="#top">Skip to the page</a>

		<header class="bar">
			<a class="logo" href={base} aria-label="iNiR">inir<em>.space</em></a>
			<nav class="pill" aria-label="Site">
				<a href="#families">Families</a>
				<a href="#new">New</a>
				<a href="#install">Install</a>
				<a href={docs()}>Docs</a>
			</nav>
		</header>

		<main id="top">
			<section class="hero">
				<div class="strip" aria-hidden="true">
					{strip.map((name, index) => (
						<img {...shot(name)} sizes="30vw" width="1920" height="1080" alt="" style={`--i:${index - 2}`}
							loading={index === 2 ? 'eager' : 'lazy'} fetchpriority={index === 2 ? 'high' : 'auto'} />
					))}
				</div>
				<aside class="hero-note">
					<img src={asset('favicon.svg')} alt="" width="34" height="34" />
					<p>Free software, GPL-3.0.<br />Built on Quickshell.</p>
				</aside>
				<h1>Your entire <em>desktop</em> for Niri, <span class="dim"><u>bar, dock, settings</u> and wallpapers in one shell.</span></h1>
				<div class="actions">
					<a class="button primary" href="#install">Install iNiR</a>
					<a class="button" href={docs()}>Read the docs</a>
				</div>
			</section>

			<section class="families" id="families" aria-labelledby="families-title">
				<h2 class="sr-only" id="families-title">Three families</h2>
				<ul class="cards">
					{families.map((family) => (
						<li>
							<a href={docs(family.doc)} class="card">
								<span class="card-art"><img {...shot(family.shot)} sizes="(max-width: 900px) 90vw, 30vw" width="1920" height="1080" alt="" loading="lazy" /></span>
								<span class="card-text"><strong>{family.name}.</strong> {family.line}</span>
							</a>
						</li>
					))}
				</ul>
			</section>

			<section class="list" id="new" aria-labelledby="new-title">
				<header class="list-head">
					<h2 id="new-title">New in {minor}</h2>
					<a class="round" href={changelog} aria-label="The whole changelog"><span>All releases</span><i aria-hidden="true">+</i></a>
				</header>
				<ol class="rows">
					{latest.map((item, index) => (
						<li class="row">
							<span class="row-index">{String(index + 1).padStart(2, '0')} /</span>
							<h3>{item.name}</h3>
							<p>{item.text}</p>
							{item.command && <button type="button" class="tag" data-copy={item.command}><code>{item.command}</code></button>}
						</li>
					))}
				</ol>
			</section>

			<section class="list things" id="things" aria-labelledby="things-title">
				<header class="list-head">
					<h2 id="things-title">What is in it</h2>
				</header>
				<ol class="rows">
					{things.map((item, index) => (
						<li class="row">
							<span class="row-index">{String(index + 1).padStart(2, '0')} /</span>
							<h3><a href={docs(item.doc)}>{item.name}</a></h3>
							<p>{item.text}</p>
							<span class="tags">{item.tags.map((tag) => <span>{tag}</span>)}</span>
						</li>
					))}
				</ol>
			</section>

			<section class="install" id="install" aria-labelledby="install-title">
				<h2 id="install-title">Clone<span aria-hidden="true">*</span><br />Install<br />Log in</h2>
				<div class="install-card">
					<p>Three lines. The installer asks before each step and checks your Qt first.</p>
					<ol>
						{install.map((line) => <li><code>{line}</code></li>)}
					</ol>
					<button type="button" class="copy" data-copy={install.join('\n')}>Copy all three</button>
				</div>
				<ul class="distros">
					{distros.map((distro) => (
						<li><strong>{distro.label}</strong><span>{distro.support}</span></li>
					))}
				</ul>
			</section>
		</main>

		<footer class="foot" id="contact">
			<a class="ask" href={discord}>Questions? <em>Ask</em> in the Discord.</a>
			<nav class="foot-links" aria-label="More">
				<a href={docs()}>Docs</a>
				<a href={docs('keybinds/')}>Keybinds</a>
				<a href={changelog}>Changelog</a>
				<a href={repo}>GitHub</a>
				<a href={discord}>Discord</a>
			</nav>
			<p class="credit">iNiR{release.version && ` ${release.version}`}, made by snowarch and the people who show up in the Discord. Built on <a href="https://github.com/YaLTeR/niri">Niri</a> and <a href="https://quickshell.outfoxxed.me/">Quickshell</a>.</p>
		</footer>

		<script>
			const copy = (button: HTMLElement) => {
				navigator.clipboard?.writeText(button.dataset.copy ?? '').then(() => {
					button.classList.add('copied');
					setTimeout(() => button.classList.remove('copied'), 1600);
				});
			};
			document.querySelectorAll<HTMLElement>('[data-copy]').forEach((button) => button.addEventListener('click', () => copy(button)));

			// Things settle in as they scroll into view; with motion reduced they are simply there.
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
				const seen = new IntersectionObserver((entries) => {
					for (const entry of entries) if (entry.isIntersecting) { entry.target.classList.add('in'); seen.unobserve(entry.target); }
				}, { rootMargin: '0px 0px -8% 0px' });
				document.querySelectorAll('.card, .row, .install h2, .install-card, .distros, .ask').forEach((node) => { node.classList.add('rise'); seen.observe(node); });
			}

			const bar = document.querySelector('.bar');
			const onScroll = () => bar?.classList.toggle('lifted', scrollY > 24);
			addEventListener('scroll', onScroll, { passive: true });
			onScroll();
		</script>
	</body>
</html>
