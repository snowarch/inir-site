---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/tokens.css';
import '../styles/home.css';
import release from '../release.generated.json';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (path = '') => `${base}docs/${path}`;
const asset = (path) => `${base}${path}`;
// Screenshots ship at 1920 wide with a 960 wide copy beside them (name-960.webp).
const shot = (name) => ({
	src: asset(`shots/${name}.webp`),
	srcset: `${asset(`shots/${name}-960.webp`)} 960w, ${asset(`shots/${name}.webp`)} 1920w`,
});
const repo = 'https://github.com/snowarch/iNiR';
const discord = 'https://discord.gg/pAPTfAhZUJ';
const install = ['git clone https://github.com/snowarch/inir.git', 'cd inir', './setup install'];

const families = [
	{ id: 'material', name: 'Material ii', shot: 'material-1' },
	{ id: 'waffle', name: 'Waffle', shot: 'waffle-1' },
	{ id: 'iris', name: 'iRiS', shot: 'iris-dock' },
];

const distros = [
	{ id: 'archlinux', name: 'Arch' },
	{ id: 'voidlinux', name: 'Void' },
	{ id: 'fedora', name: 'Fedora' },
	{ id: 'debian', name: 'Debian' },
	{ id: 'ubuntu', name: 'Ubuntu' },
	{ id: 'nixos', name: 'NixOS' },
];

const tiles = [
	{ shot: 'iris-card', size: 'wide', title: 'Colour from your wallpaper', line: 'The shell, terminals, GTK and Qt apps follow it.' },
	{ shot: 'material-2', size: 'tall', title: 'Settings for everything', line: 'No config files to edit.' },
	{ shot: 'waffle-2', size: '', title: 'Quick settings', line: 'Wi-Fi, Bluetooth, sound and brightness.' },
	{ shot: 'material-4', size: '', title: 'Desktop widgets', line: 'Clock, media and weather on the wallpaper.' },
	{ shot: 'iris-light', size: 'full', title: 'Light and dark', line: 'Switch any time in Settings.' },
];

const description = 'A complete desktop shell for Niri: bar, dock, notifications, lock screen, wallpapers and Settings. Built on Quickshell.';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>iNiR, the desktop shell for Niri</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0a0a0a" />
		<link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
		<meta property="og:title" content="iNiR" />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={asset('shots/material-1.webp')} />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>document.documentElement.classList.add('js');</script>
	</head>
	<body>
		<header class="nav">
			<a class="brand" href={base}><img src={asset('favicon.svg')} alt="" width="26" height="26" />iNiR</a>
			<nav aria-label="Site">
				<a href="#features">Features</a>
				<a href="#install">Install</a>
				<a href={docs()}>Docs</a>
			</nav>
			<div class="nav-icons">
				<a href={repo} aria-label="GitHub"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.1c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg></a>
				<a href={discord} aria-label="Discord"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.3 4.4A19.8 19.8 0 0 0 15.4 3l-.6 1.3a18.3 18.3 0 0 0-5.5 0L8.6 3a19.7 19.7 0 0 0-4.9 1.5C.6 9.1-.3 13.6.1 18.1a19.9 19.9 0 0 0 6 3l1.3-2.1c-.7-.3-1.4-.6-2-1l.5-.4a14.2 14.2 0 0 0 12.2 0l.5.4c-.6.4-1.3.7-2 1l1.3 2.1a19.8 19.8 0 0 0 6-3c.5-5.2-.9-9.7-3.6-13.7ZM8 15.3c-1.2 0-2.2-1.1-2.2-2.4S6.8 10.5 8 10.5s2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Zm8 0c-1.2 0-2.2-1.1-2.2-2.4s1-2.4 2.2-2.4 2.2 1.1 2.2 2.4-1 2.4-2.2 2.4Z"/></svg></a>
				<a class="nav-cta" href="#install">Install</a>
			</div>
		</header>

		<main>
			<section class="hero">
				{release.version && <a class="pill" href={`${repo}/releases`}>{release.title ?? 'Release'} <span>{release.version}</span></a>}
				<h1>The desktop shell<br />for Niri.</h1>
				<p class="lede">Bar, dock, notifications, lock screen, wallpapers and Settings. One shell, three families.</p>
				<div class="actions">
					<a class="btn btn-primary" href="#install">Install iNiR</a>
					<a class="btn" href={docs()}>Documentation</a>
				</div>

				<div class="showcase">
					<div class="tabs" role="tablist" aria-label="Families">
						{families.map((family, index) => (
							<button type="button" role="tab" aria-selected={index === 0 ? 'true' : 'false'} data-family={family.id}>{family.name}</button>
						))}
					</div>
					<div class="screen">
						{families.map((family, index) => (
							<img {...shot(family.shot)} sizes="(max-width: 1240px) 94vw, 1200px" width="1920" height="1080"
								alt={`iNiR with the ${family.name} family`} data-family={family.id} class={index === 0 ? 'on' : ''}
								loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
						))}
					</div>
				</div>

				<ul class="distros" aria-label="Supported distributions">
					{distros.map((distro) => (
						<li><i style={`--icon: url(${asset(`distros/${distro.id}.svg`)})`} aria-hidden="true"></i>{distro.name}</li>
					))}
				</ul>
			</section>

			<section class="features" id="features">
				<h2>Everything around your windows.</h2>
				<div class="bento">
					{tiles.map((tile) => (
						<figure class={`tile ${tile.size}`}>
							<img {...shot(tile.shot)} sizes="(max-width: 900px) 94vw, 50vw" width="1920" height="1080" alt="" loading="lazy" />
							<figcaption><strong>{tile.title}</strong><span>{tile.line}</span></figcaption>
						</figure>
					))}
				</div>
			</section>

			<section class="install" id="install">
				<h2>Install</h2>
				<p>The installer checks your system and asks before each step.</p>
				<div class="term">
					<pre><code>{install.join('\n')}</code></pre>
					<button type="button" class="copy" data-copy={install.join('\n')} aria-label="Copy the commands">Copy</button>
				</div>
				<ul class="distros big" aria-label="Supported distributions">
					{distros.map((distro) => (
						<li><a href={docs(distro.id === 'voidlinux' ? 'void/' : distro.id === 'nixos' ? 'nixos/' : 'install/')}><i style={`--icon: url(${asset(`distros/${distro.id}.svg`)})`} aria-hidden="true"></i>{distro.name}</a></li>
					))}
				</ul>
			</section>
		</main>

		<footer class="foot">
			<a class="brand" href={base}><img src={asset('favicon.svg')} alt="" width="22" height="22" />iNiR</a>
			<nav aria-label="More">
				<a href={docs()}>Docs</a>
				<a href={`${repo}/blob/main/CHANGELOG.md`}>Changelog</a>
				<a href={repo}>GitHub</a>
				<a href={discord}>Discord</a>
			</nav>
			<p>GPL-3.0. Built on <a href="https://github.com/YaLTeR/niri">Niri</a> and <a href="https://quickshell.outfoxxed.me/">Quickshell</a>.</p>
		</footer>

		<script>
			document.querySelectorAll<HTMLElement>('[data-copy]').forEach((button) => button.addEventListener('click', () => {
				navigator.clipboard?.writeText(button.dataset.copy ?? '').then(() => {
					button.textContent = 'Copied';
					setTimeout(() => (button.textContent = 'Copy'), 1500);
				});
			}));

			const tabs = [...document.querySelectorAll<HTMLElement>('.tabs [data-family]')];
			const shots = [...document.querySelectorAll<HTMLElement>('.screen [data-family]')];
			tabs.forEach((tab) => tab.addEventListener('click', () => {
				tabs.forEach((other) => other.setAttribute('aria-selected', String(other === tab)));
				shots.forEach((img) => img.classList.toggle('on', img.dataset.family === tab.dataset.family));
			}));

			// The screenshot leans back at first and settles flat as the page scrolls.
			const screen = document.querySelector<HTMLElement>('.screen');
			if (screen && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
				let queued = false;
				const tilt = () => {
					queued = false;
					const box = screen.getBoundingClientRect();
					const p = Math.min(1, Math.max(0, 1 - (box.top - innerHeight * 0.2) / (innerHeight * 0.6)));
					screen.style.transform = `perspective(1800px) rotateX(${(16 * (1 - p)).toFixed(2)}deg) scale(${(0.94 + 0.06 * p).toFixed(3)})`;
				};
				addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(tilt); } }, { passive: true });
				tilt();
			}
		</script>
	</body>
</html>
