---
import Site from '../layouts/Site.astro';
import { day, hub, releases, version } from '../lib/data';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (path = '') => `${base}docs/${path}`;
// Screenshots ship at 1920 wide with a 960 wide copy beside them (name-960.webp).
const shot = (name: string) => ({
	src: `${base}shots/${name}.webp`,
	srcset: `${base}shots/${name}-960.webp 960w, ${base}shots/${name}.webp 1920w`,
});
const install = ['git clone https://github.com/snowarch/inir.git', 'cd inir', './setup install'];
const latest = releases[0];
const iris = releases.find((release) => release.iris)?.iris;

// The hero takes turns through iRiS, the family the release notes number.
const reel = ['iris-principal', 'iris-desktop', 'iris-dock', 'iris-card', 'iris-light'];

const families = [
	{ hub: 'ii', name: 'Material ii', shot: 'material-1' },
	{ hub: 'waffle', name: 'Waffle', shot: 'waffle-1' },
	{ hub: 'iris', name: 'iRiS', shot: 'iris-dock' },
].map((family) => ({ ...family, version: hub?.items.find((item) => item.id === family.hub)?.version }));

const distros = [
	{ id: 'archlinux', name: 'Arch', doc: 'install/' },
	{ id: 'voidlinux', name: 'Void', doc: 'void/' },
	{ id: 'fedora', name: 'Fedora', doc: 'install/' },
	{ id: 'debian', name: 'Debian', doc: 'install/' },
	{ id: 'ubuntu', name: 'Ubuntu', doc: 'install/' },
	{ id: 'nixos', name: 'NixOS', doc: 'nixos/' },
];

const features = [
	{ shot: 'material-2', title: 'Settings app', doc: 'config-system/' },
	{ shot: 'iris-card', title: 'Wallpaper colour', doc: 'theming-presets/' },
	{ shot: 'waffle-2', title: 'Quick settings', doc: 'panel-families/' },
	{ shot: 'material-3', title: 'Sidebars', doc: 'panel-families/' },
	{ shot: 'material-4', title: 'Desktop widgets', doc: 'desktop-items/' },
	{ shot: 'iris-light', title: 'Light and dark', doc: 'theming-presets/' },
];
const arrow = '<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 8h8M8.5 4.5 12 8l-3.5 3.5"/></svg>';
const copy = '<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="5" width="8.5" height="8.5" rx="2"/><path d="M3 10.5V4a1.5 1.5 0 0 1 1.5-1.5H11"/></svg>';
---

<Site title="iNiR, the desktop shell for Niri" description="iNiR is a complete desktop shell for the Niri compositor, built on Quickshell.">
	<section class="row split hero">
		<div class="pad">
			{version && (
				<a class="release tag" href={`${base}changelog/`}><i aria-hidden="true"></i><b>v{version}</b>{iris && <span>iRiS {iris}</span>}{latest && <span>{day(latest.date)}</span>}</a>
			)}
			<h1>The desktop shell for Niri.</h1>
			<p class="sub">Built on Quickshell. Set up from one app, no config files.</p>
			<div class="cmd">
				<code><span class="pr">$</span>{install.join(' && ')}</code>
				<button type="button" class="copy" data-copy={install.join('\n')} aria-label="Copy the install commands" set:html={copy} />
			</div>
			<div class="links">
				<a href={docs('install/')}>Install guide <Fragment set:html={arrow} /></a>
				<a href={docs()}>Docs <Fragment set:html={arrow} /></a>
			</div>
		</div>
		<div class="reel" data-reel>
			<div class="reel-stage">
				{reel.map((name, index) => (
					<img {...shot(name)} sizes="(max-width: 900px) 94vw, 660px" width="1920" height="1080" alt={index === 0 ? 'iNiR with the iRiS family' : ''}
						class={index === 0 ? 'on' : undefined} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} />
				))}
			</div>
			<div class="reel-foot">
				<span class="tag reel-name">iRiS{iris && ` ${iris}`}</span>
				<div class="reel-bars">
					{reel.map((_, index) => <button type="button" aria-label={`Screenshot ${index + 1}`} class={index === 0 ? 'on' : undefined}></button>)}
				</div>
			</div>
		</div>
	</section>

	<section class="row" aria-labelledby="families">
		<div class="head"><span class="lbl" id="families">Families</span><a class="lbl" href={docs('panel-families/')}>How they differ <Fragment set:html={arrow} /></a></div>
		<div class="cells">
			{families.map((family) => (
				<a class="fam" href={docs('panel-families/')}>
					<img {...shot(family.shot)} sizes="(max-width: 900px) 94vw, 380px" width="1920" height="1080" alt={`iNiR, ${family.name} family`} loading="lazy" />
					<p>{family.name}{family.version && <span class="tag">v{family.version}</span>}</p>
				</a>
			))}
		</div>
	</section>

	{latest && (
		<section class="row news" aria-labelledby="news">
			<div class="head"><span class="lbl" id="news">What's new</span><a class="lbl" href={`${base}changelog/`}>Changelog <Fragment set:html={arrow} /></a></div>
			<div class="split">
				<div class="pad">
					<span class="ver">{latest.version}</span>
					<div class="meta tag">{latest.iris && <span class="iris">iRiS {latest.iris}</span>}<span>{day(latest.date)}</span></div>
					{latest.summary && <p class="sum">{latest.summary}</p>}
				</div>
				<ul class="hl">
					{latest.added.slice(0, 6).map((item) => <li><b>{item.name ?? 'New'}</b><span>{item.text}</span></li>)}
				</ul>
			</div>
			{releases.length > 1 && (
				<div class="past">
					{releases.slice(1, 3).map((release) => (
						<a href={`${base}changelog/#v${release.version}`}>
							<span class="v"><b>{release.version}</b><span class="tag">{release.iris && `iRiS ${release.iris} · `}{day(release.date)}</span></span>
							{release.summary && <p>{release.summary}</p>}
						</a>
					))}
				</div>
			)}
		</section>
	)}

	<section class="row" aria-labelledby="runs">
		<div class="head"><span class="lbl" id="runs">Runs on</span></div>
		<div class="runs">
			{distros.map((distro) => (
				<a href={docs(distro.doc)}><i class="di" style={`--icon: url(${base}distros/${distro.id}.svg)`} aria-hidden="true"></i>{distro.name}</a>
			))}
		</div>
	</section>

	<section class="row" aria-labelledby="inside">
		<div class="head"><span class="lbl" id="inside">Inside</span></div>
		<div class="inside" data-inside>
			<ol>
				{features.map((feature, index) => (
					<li class={index === 0 ? 'on' : undefined}><a href={docs(feature.doc)}>{feature.title}<Fragment set:html={arrow} /></a></li>
				))}
			</ol>
			<div class="stage">
				{features.map((feature, index) => (
					<img {...shot(feature.shot)} sizes="760px" width="1920" height="1080" alt={feature.title}
						class={index === 0 ? 'on' : undefined} aria-hidden={index === 0 ? undefined : 'true'} loading="lazy" />
				))}
			</div>
		</div>
	</section>

	<section class="row split" id="install" aria-labelledby="install-title">
		<div class="pad">
			<span class="lbl">Install</span>
			<h2 id="install-title" style="margin-top: 14px">Three commands.</h2>
			<p class="sub" style="margin-top: 8px">Restart, then pick Niri at the login screen.</p>
			<div class="links"><a href={docs('install/')}>Install guide <Fragment set:html={arrow} /></a></div>
		</div>
		<div class="term">
			<button type="button" class="copy" data-copy={install.join('\n')}><Fragment set:html={copy} /><span>Copy</span></button>
			<pre>{install.map((line) => <><span class="pr">$</span>{line}{'\n'}</>)}</pre>
		</div>
	</section>
</Site>

<script>
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

	// iRiS takes turns in the hero: a bar fills while a screenshot shows, the next fades in when it's full. Hover,
	// focus or a hidden tab holds it; a bar jumps to its screenshot.
	const reel = document.querySelector<HTMLElement>('[data-reel]');
	if (reel) {
		const shots = [...reel.querySelectorAll<HTMLImageElement>('.reel-stage img')];
		const bars = [...reel.querySelectorAll<HTMLButtonElement>('.reel-bars button')];
		const hold = 6000;
		let index = 0, timer = 0, hovered = false, hidden = false;
		reel.style.setProperty('--reel', `${hold}ms`);
		const show = (next: number) => {
			shots[index].classList.remove('on');
			bars[index].classList.remove('on');
			index = (next + shots.length) % shots.length;
			shots[(index + 1) % shots.length].loading = 'eager';
			// Restart the bar's fill from empty.
			void bars[index].offsetWidth;
			shots[index].classList.add('on');
			bars[index].classList.add('on');
			schedule();
		};
		const schedule = () => {
			clearTimeout(timer);
			if (!hovered && !hidden && !reduce) timer = window.setTimeout(() => show(index + 1), hold);
		};
		// Hover and a hidden tab hold it separately: coming back to the tab with the pointer still on it stays held.
		const apply = () => {
			const held = hovered || hidden;
			reel.classList.toggle('paused', held);
			if (held) clearTimeout(timer);
			else show(index);
		};
		bars.forEach((bar, i) => bar.addEventListener('click', () => show(i)));
		reel.addEventListener('pointerenter', () => { hovered = true; apply(); });
		reel.addEventListener('pointerleave', () => { hovered = false; apply(); });
		document.addEventListener('visibilitychange', () => { hidden = document.hidden; apply(); });
		if (reduce) reel.classList.add('paused');
		shots[1].loading = 'eager';
		schedule();
	}

	// Inside: pointing at or tabbing to a name shows its screenshot.
	const inside = document.querySelector<HTMLElement>('[data-inside]');
	if (inside) {
		const names = [...inside.querySelectorAll<HTMLElement>('li')];
		const pics = [...inside.querySelectorAll<HTMLImageElement>('.stage img')];
		let active = 0;
		const focus = (i: number) => {
			if (i === active) return;
			names[active].classList.remove('on');
			pics[active].classList.remove('on');
			pics[active].setAttribute('aria-hidden', 'true');
			names[i].classList.add('on');
			pics[i].classList.add('on');
			pics[i].removeAttribute('aria-hidden');
			active = i;
		};
		names.forEach((li, i) => {
			li.addEventListener('pointerenter', () => focus(i));
			li.addEventListener('focusin', () => focus(i));
		});
		new IntersectionObserver((entries, seen) => {
			if (!entries.some((e) => e.isIntersecting)) return;
			seen.disconnect();
			pics.forEach((img) => (img.loading = 'eager'));
		}, { rootMargin: '50% 0px' }).observe(inside);
	}
</script>
