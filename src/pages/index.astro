---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/rubik/500.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = (path = '') => `${base}docs/${path}`;
const media = (path) => `${base}docs-media/${path}`;
const repo = 'https://github.com/snowarch/iNiR';
const discord = 'https://discord.gg/pAPTfAhZUJ';
const install = ['git clone https://github.com/snowarch/inir.git', 'cd inir', './setup install'];

const families = [
	{ name: 'iRiS', line: 'An Island on any screen edge that grows into pages, cards and panels. Pieces you can carry, a Dock on any edge, whole-redesign themes.' },
	{ name: 'Material ii', line: 'A floating bar, sidebars and a dock, with nine global styles from Material to Editorial.' },
	{ name: 'Waffle', line: 'A Windows 11 style taskbar, start menu, action center and notification center.' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>iNiR</title>
		<meta name="description" content="A complete desktop shell for Niri, built on Quickshell." />
		<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
		<meta property="og:title" content="iNiR" />
		<meta property="og:description" content="A complete desktop shell for Niri, built on Quickshell." />
		<meta property="og:image" content={media('images/iris-2.31-principal.webp')} />
	</head>
	<body>
		<header class="bar">
			<a class="mark" href={base}>
				<img src={`${base}favicon.svg`} alt="" width="22" height="22" />
				<span>iNiR</span>
			</a>
			<nav>
				<a href={docs()}>Docs</a>
				<a href={docs('iris/')}>iRiS</a>
				<a href={repo}>GitHub</a>
				<a href={discord}>Discord</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<h1>iNiR</h1>
				<p class="lede">A complete desktop shell for Niri, built on Quickshell.</p>
				<p class="sub">The bar, the Dock, notifications, settings, wallpapers and the lock screen, as one shell you shape from its own settings.</p>
				<div class="actions">
					<a class="primary" href={docs('install/')}>Install</a>
					<a class="quiet" href={docs()}>Read the docs</a>
				</div>
				<figure class="shot">
					<img src={media('images/iris-2.31-principal.webp')} alt="The iRiS desktop: the Island on the top edge, pieces and the Dock" width="1920" height="1080" />
				</figure>
			</section>

			<section class="families">
				<h2>Three families, one shell</h2>
				<p class="hint">Switch between them any time with <kbd>Super</kbd> <kbd>Shift</kbd> <kbd>W</kbd>.</p>
				<ul>
					{families.map((family) => (
						<li>
							<h3>{family.name}</h3>
							<p>{family.line}</p>
						</li>
					))}
				</ul>
			</section>

			<section class="gallery">
				<img src={media('images/iris-2.31-desktop.webp')} alt="iRiS desktop layout with pieces on the screen contour" loading="lazy" />
				<img src={media('images/iris-2.31-card.webp')} alt="An iRiS card grown from a piece" loading="lazy" />
				<img class="wide" src={media('images/iris-2.31-dock.webp')} alt="The iRiS Dock and edge layout" loading="lazy" />
			</section>

			<section class="install">
				<h2>Install</h2>
				<pre><code>{install.join('\n')}</code></pre>
				<p class="hint">Arch is the primary target. Fedora and Debian or Ubuntu have automated paths too. iNiR needs Qt 6.9 or newer. Restart after the installer finishes, then pick Niri at the login screen.</p>
				<a class="quiet" href={docs('install/')}>Everything about installing</a>
			</section>
		</main>

		<footer>
			<span>GPL-3.0</span>
			<a href={repo}>GitHub</a>
			<a href={discord}>Discord</a>
			<a href={docs()}>Docs</a>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--field: #000;
		--raised: #1c1c1e;
		--line: rgba(255, 255, 255, 0.08);
		--ink: #f5f5f7;
		--quiet: #a1a1a6;
		--accent: #ff9f0a;
		color-scheme: dark;
	}
	* { box-sizing: border-box; }
	html, body { margin: 0; background: var(--field); color: var(--ink); }
	body { font: 16px/1.55 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
	a { color: inherit; text-decoration: none; }
	kbd { font: 500 0.85em 'Rubik', sans-serif; padding: 0.1em 0.45em; border-radius: 6px; background: var(--raised); }

	.bar {
		position: sticky; top: 12px; z-index: 2; margin: 12px auto 0; width: min(760px, calc(100% - 32px));
		display: flex; align-items: center; justify-content: space-between; gap: 16px;
		padding: 10px 12px 10px 18px; border-radius: 999px;
		background: rgba(18, 18, 20, 0.72); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
		box-shadow: 0 0 0 1px var(--line), 0 12px 32px rgba(0, 0, 0, 0.45);
	}
	.mark { display: flex; align-items: center; gap: 10px; font-weight: 600; }
	.bar nav { display: flex; gap: 4px; flex-wrap: wrap; }
	.bar nav a { padding: 6px 12px; border-radius: 999px; color: var(--quiet); font-size: 14px; font-weight: 500; }
	.bar nav a:hover { color: var(--ink); background: rgba(255, 255, 255, 0.06); }

	main { width: min(1120px, calc(100% - 32px)); margin: 0 auto; }
	section { padding: 96px 0 0; }
	h1, h2, h3 { margin: 0; letter-spacing: -0.02em; }

	.hero { text-align: center; padding-top: 88px; }
	.hero h1 { font-size: clamp(56px, 9vw, 104px); font-weight: 700; line-height: 1; }
	.lede { margin: 20px auto 0; max-width: 620px; font-size: clamp(19px, 2.4vw, 24px); font-weight: 500; }
	.sub { margin: 12px auto 0; max-width: 560px; color: var(--quiet); }
	.actions { display: flex; justify-content: center; gap: 10px; margin-top: 32px; flex-wrap: wrap; }
	.primary, .quiet { display: inline-flex; align-items: center; height: 44px; padding: 0 22px; border-radius: 999px; font-weight: 600; }
	.primary { background: var(--accent); color: #1a0f00; }
	.primary:hover { filter: brightness(1.08); }
	.quiet { background: var(--raised); color: var(--ink); }
	.quiet:hover { background: #2c2c2e; }
	.shot { margin: 64px 0 0; }
	.shot img, .gallery img { display: block; width: 100%; height: auto; border-radius: 20px; box-shadow: 0 0 0 1px var(--line), 0 30px 80px rgba(0, 0, 0, 0.6); }

	.families h2, .install h2 { font-size: clamp(28px, 4vw, 40px); }
	.hint { color: var(--quiet); margin: 12px 0 0; }
	.families ul { list-style: none; padding: 0; margin: 40px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }
	.families li { padding: 4px 28px 4px 0; }
	.families li + li { padding-left: 28px; box-shadow: -1px 0 0 var(--line); }
	.families h3 { font-size: 20px; }
	.families h3::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 10px; vertical-align: 0.15em; background: var(--quiet); }
	.families li:first-child h3::before { background: var(--accent); }
	.families p { color: var(--quiet); margin: 10px 0 0; }

	.gallery { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
	.gallery .wide { grid-column: 1 / -1; }

	.install pre {
		margin: 28px 0 0; padding: 20px 24px; border-radius: 16px; background: var(--raised); overflow-x: auto;
		font: 15px/1.7 ui-monospace, 'JetBrains Mono', monospace; color: var(--ink);
	}
	.install .quiet { margin-top: 24px; }

	footer {
		width: min(1120px, calc(100% - 32px)); margin: 120px auto 0; padding: 28px 0 48px;
		display: flex; gap: 24px; color: var(--quiet); font-size: 14px; box-shadow: 0 -1px 0 var(--line);
	}
	footer a:hover { color: var(--ink); }

	@media (max-width: 760px) {
		.families ul { grid-template-columns: 1fr; gap: 28px; }
		.families li, .families li + li { padding: 0; box-shadow: none; }
		.gallery { grid-template-columns: 1fr; }
		.bar { padding-left: 14px; }
		.bar nav a { padding: 6px 8px; }
	}
</style>
