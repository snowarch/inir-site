---
import Site from '../layouts/Site.astro';
import { day, releases } from '../lib/data';

const repo = 'https://github.com/snowarch/iNiR';
// The newest dozen; the rest stay in CHANGELOG.md on GitHub.
const shown = releases.slice(0, 12);
const arrow = '<svg class="ic" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 8h8M8.5 4.5 12 8l-3.5 3.5"/></svg>';
---

<Site title="Changelog, iNiR" description="Every iNiR release, newest first." page="changelog">
	<section class="row">
		<div class="pad">
			<span class="lbl">Changelog</span>
			<h1 style="margin-top: 14px">Every release, newest first.</h1>
			<div class="links"><a href={`${repo}/blob/main/CHANGELOG.md`}>CHANGELOG.md <Fragment set:html={arrow} /></a><a href={`${repo}/releases`}>Releases <Fragment set:html={arrow} /></a></div>
		</div>
	</section>
	{shown.map((release) => (
		<section class="row rel" id={`v${release.version}`}>
			<div>
				<div class="sticky">
					<span class="ver">{release.version}</span>
					<span class="tag">{release.iris && <span class="iris">iRiS {release.iris} · </span>}{day(release.date)}</span>
				</div>
			</div>
			<div class="body">
				{release.summary && <p>{release.summary}</p>}
				{release.added.length > 0 && (<><h3 class="lbl">Added</h3><ul>{release.added.map((item) => <li>{item.name && <><strong>{item.name}</strong>: </>}<Fragment set:html={item.html} /></li>)}</ul></>)}
				{release.changed.length > 0 && (<><h3 class="lbl">Changed</h3><ul>{release.changed.map((item) => <li>{item.name && <><strong>{item.name}</strong>: </>}<Fragment set:html={item.html} /></li>)}</ul></>)}
				{release.fixed.length > 0 && (
					<details class="fixes">
						<summary class="lbl"><h3 style="display: inline; font: inherit">Fixed</h3></summary>
						<ul>{release.fixed.map((item) => <li>{item.name && <><strong>{item.name}</strong>: </>}<Fragment set:html={item.html} /></li>)}</ul>
					</details>
				)}
			</div>
		</section>
	))}
	{shown.length === 0 && <section class="row"><p class="empty">The release notes were not part of this build.</p></section>}
</Site>
